import java.util.Scanner;

public class CountEvenNumbers {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        
        int N = sc.nextInt();

        
        int[] arr = new int[N];
        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        
        int evenCount = 0;
        for (int i = 0; i < N; i++) {
            if (arr[i] % 2 == 0) {
                evenCount++;
            }
        }

        
        System.out.println(evenCount);

        sc.close();
    }
}
