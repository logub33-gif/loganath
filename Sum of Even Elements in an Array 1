import java.util.Scanner;

public class SumEvenElements {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        
        int N = sc.nextInt();
        int[] arr = new int[N];

        
        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

       
        int evenSum = 0;
        for (int num : arr) {
            if (num % 2 == 0) {
                evenSum += num;
            }
        }

       
        System.out.println(evenSum);

        sc.close();
    }
}
